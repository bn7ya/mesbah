# Copy to .env before running docker compose. Never commit .env.
#
#   cp .env.example .env

# ---------------------------------------------------------------- Django
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate one with:
#   python -c "from secrets import token_urlsafe; print(token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-before-you-run-anything
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://localhost

# Created by `manage.py createsuperuser --noinput` on first boot when all three are set.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin

# ---------------------------------------------------------------- Postgres
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------------------------------------------------------------- Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------------------------------------------------------------- Built-in engine
# The `runtime` service (--profile ml, or compose.gpu.yaml) answers only to this token.
#   python -c "from secrets import token_urlsafe; print(token_urlsafe(32))"
MESBAH_RUNTIME_URL=http://runtime:8078
MESBAH_RUNTIME_TOKEN=change-me-as-well

# ---------------------------------------------------------------- Backups
# django-dbs. The key is derived from this passphrase with Argon2id and is never
# stored anywhere — lose it and every backup is unreadable. Keep it somewhere
# that is not this machine.
#
#   python -c "from secrets import token_urlsafe; print(token_urlsafe(32))"
DBS_PASSPHRASE=change-me-and-store-me-somewhere-else
DBS_BACKUP_DIR=/var/backups/app

# The schedule the `backup` service runs until the one in the panel at
# /admin/dbs/backupschedule/ is turned on and the service restarted.
DBS_SCHEDULE_INTERVAL=6h
DBS_SCHEDULE_KEEP=14

# Offsite push. With DBS_SSH_HOST set, every scheduled backup is also pushed
# here and the newest DBS_SCHEDULE_KEEP_REMOTE are kept. Leave it empty to keep
# backups local only.
DBS_SCHEDULE_KEEP_REMOTE=30
DBS_SSH_HOST=
DBS_SSH_USERNAME=
DBS_SSH_KEY_FILENAME=
DBS_SSH_REMOTE_DIR=/var/backups/app
DBS_SSH_KNOWN_HOSTS=/root/.ssh/known_hosts

# ---------------------------------------------------------------- Ports
FRONTEND_PORT=4200
BACKEND_PORT=8000
NGINX_PORT=80

# ---------------------------------------------------------------- Web (prod)
# uvicorn processes serving the API. Each holds its own database connection pool.
WEB_WORKERS=3
