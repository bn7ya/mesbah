# syntax=docker/dockerfile:1.7
#
# Django/DRF side of Mesbah's in-progress backend migration (see the root
# plan and apps/common/CLAUDE.md). Separate from any future FastAPI
# container image — backend/app/ (FastAPI) still runs bare-metal per
# backend/CLAUDE.md and is untouched by this file.

# ----------------------------------------------------------------- base
FROM python:3.13-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# libpq for psycopg, curl for the healthcheck, gettext for makemessages.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libpq5 curl gettext \
 && rm -rf /var/lib/apt/lists/*

COPY requirements-django.txt requirements-django-dev.txt ./

# ------------------------------------------------------------------ dev
FROM base AS dev

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential libpq-dev \
 && pip install --no-cache-dir -r requirements-django-dev.txt \
 && apt-get purge -y build-essential libpq-dev \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

COPY . .

RUN chmod +x ./entrypoint.django.sh

EXPOSE 8000
ENTRYPOINT ["./entrypoint.django.sh"]
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]

# ----------------------------------------------------------------- prod
FROM base AS prod

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential libpq-dev \
 && pip install --no-cache-dir -r requirements-django.txt \
 && apt-get purge -y build-essential libpq-dev \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

COPY . .

RUN chmod +x ./entrypoint.django.sh \
 && useradd --system --create-home --uid 10001 app \
 && mkdir -p /app/staticfiles /app/media \
 && chown -R app:app /app

USER app

EXPOSE 8000
ENTRYPOINT ["./entrypoint.django.sh"]
CMD ["gunicorn", "config.wsgi:application", "--bind=0.0.0.0:8000"]
